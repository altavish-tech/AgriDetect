# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Database
DB_PATH=./database/agridetect.db

# AI Service (when real API is configured)
AI_API_URL=
AI_API_KEY=

# Weather API (optional - when configured)
WEATHER_API_KEY=

# SMS/Email (optional - when configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Security
JWT_SECRET=your-secret-key-change-in-production
